generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  fullName       String
  email          String   @unique
  phone          String
  isEmailVerified Boolean  @default(false)
  password       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  otp       Int
  otpExpiry DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, createdAt(sort: Desc)])
}

model Dispute {
  id           String        @id @default(uuid())
  escrowId     String
  raisedBy     String
  reason       String
  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedBy   String?
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([escrowId])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Admin {
  id        String      @id @default(uuid())
  fullName  String
  email     String      @unique
  password  String
  role      AdminRole   @default(ADMIN)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0)
  currency  String   @default("NGN")
  accountNumber String?
  accountName   String?
  bankName      String?
  bankCode      String?
  providerAccountReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Escrow {
  id                    String   @id @default(uuid())
  escrowCode            String   @unique
  buyerId               String
  sellerId              String
  amount                Float
  milestones            String[]
  deliveryDeadline      DateTime
  inspectionPeriodDays  Int
  description           String?
  paymentReference      String
  paymentLink           String?
  status                EscrowStatus @default(CREATED)
  proofUrl              String?
  deliveredAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([buyerId, status])
  @@index([sellerId, status])
}

model Payment {
  id                String        @id @default(uuid())
  provider          String
  providerReference String        @unique
  userId            String
  amount            Decimal
  referenceId       String?
  fee               Decimal?
  method            String?
  type              String?
  metadata          Json?
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum EscrowStatus {
  CREATED
  PENDING_PAYMENT
  FUNDED
  IN_PROGRESS
  DELIVERED
  UNDER_REVIEW
  COMPLETED
  DISPUTED
  CANCELLED
  REFUNDED
  EXPIRED
  RELEASED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYOUT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Transaction {
  id        String            @id @default(uuid())
  userId    String
  type      TransactionType
  title     String
  amount    Decimal
  status    TransactionStatus @default(PENDING)
  metadata  Json?
  // Payment-related fields (migrated from Payment model)
  provider          String?
  providerReference String?
  referenceId       String?
  fee               Decimal?
  method            String?
  paymentType       String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}

enum PromotionPlacementSlot {
  TOP_VERIFICATION
  PERSISTENT_FLOW
  MAXIMUM_VISIBILITY
}

enum Industry {
  WEB_DEVELOPMENT
  MOBILE_APPS
  SOFTWARE_DEVELOPMENT
  LOGO_DESIGN
  BRAND_GUIDELINES
  VIDEO_EDITING
  SEO_MARKETING
  OTHER
}

enum TargetAudience {
  ALL_VISITORS
  TALENT_PROVIDERS
  HIRING_MANAGERS
}

enum BadgeLabel {
  FEATURED
  HOT_DEAL
  TOP_RATED
  OUT_OF_FUEL
}

enum AdStatus {
  ACTIVE
  PAUSED
  TERMINATED
  DRAFT
}

model Advertisement {
  id                     String                   @id @default(uuid())
  customId               String                   @unique
  productTitle           String
  description            String?
  basePrice              Decimal
  coverImage             String?
  promotionPlacementSlot PromotionPlacementSlot
  industry               Industry
  targetAudience         TargetAudience
  startDate              DateTime
  endDate                DateTime
  billingDailyBudget     Decimal
  allocatedBudgetLimit   Decimal
  depositedAmount        Decimal                  @default(0)
  badgeLabel             BadgeLabel?
  presentationTheme      String?
  status                 AdStatus                 @default(DRAFT)
  impressions            Int                      @default(0)
  clicks                 Int                      @default(0)
  revenue                Decimal                  @default(0)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
}
