{
  "info": {
    "name": "Escrow Africa - Dispute System",
    "description": "API endpoints for testing the Dispute System Flow and WhatsApp Integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Dispute System",
      "item": [
        {
          "name": "1. Seed Super Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@escrowafrica.com\",\n  \"password\": \"securepassword123\",\n  \"fullName\": \"Super Administrator\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/admin/seed",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["admin", "seed"]
            }
          }
        },
        {
          "name": "2. Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if(response.accessToken) {",
                  "    pm.collectionVariables.set(\"adminToken\", response.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@escrowafrica.com\",\n  \"password\": \"securepassword123\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/admin/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["admin", "auth", "login"]
            }
          }
        },
        {
          "name": "3. Create Dispute (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if(response.id) {",
                  "    pm.collectionVariables.set(\"disputeId\", response.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"escrowId\": \"b3c2d4fa-8c1d-4b9b-9c3a-2f1e2d3c4b5a\",\n  \"reason\": \"Seller did not deliver the application source code.\"\n}"
            },
            "url": {
              "raw": "http://localhost:3001/disputes",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["disputes"]
            }
          }
        },
        {
          "name": "4. Simulate WhatsApp Webhook Evidence",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"disputeId\": \"{{disputeId}}\",\n  \"from\": \"+2348000000000\",\n  \"text\": \"Here is my screenshot showing the seller canceled the order.\",\n  \"mediaUrl\": \"https://s3.amazonaws.com/escrow-africa-evidence/proof.png\"\n}"
            },
            "url": {
              "raw": "http://localhost:3002/webhook/whatsapp",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3002",
              "path": ["webhook", "whatsapp"]
            }
          }
        },
        {
          "name": "5. Put Dispute Under Review (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "http://localhost:3001/disputes/{{disputeId}}/review",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["disputes", "{{disputeId}}", "review"]
            }
          }
        },
        {
          "name": "6. Resolve Dispute (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resolution\": \"buyer_wins\"\n}"
            },
            "url": {
              "raw": "http://localhost:3001/disputes/{{disputeId}}/resolve",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3001",
              "path": ["disputes", "{{disputeId}}", "resolve"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": "PLACE_USER_JWT_HERE"
    },
    {
      "key": "disputeId",
      "value": ""
    }
  ]
}
