{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build:gateway": "npx nx build api-gateway",
    "build:auth": "npx nx build auth-service",
    "build:dispute": "npx nx build dispute-service",
    "build:escrow": "npx nx build escrow-service",
    "build:notification": "npx nx build notification-service",
    "build:wallet": "npx nx build wallet-service",
    "serve:api": "cross-env NODE_OPTIONS= npx nx serve api-gateway",
    "serve:auth": "cross-env NODE_OPTIONS= PORT=3001 npx nx serve auth-service",
    "serve:dispute": "cross-env NODE_OPTIONS= PORT=3002 npx nx serve dispute-service",
    "serve:escrow": "cross-env NODE_OPTIONS= PORT=3003 npx nx serve escrow-service",
    "serve:notification": "cross-env NODE_OPTIONS= PORT=3004 npx nx serve notification-service",
    "serve:wallet": "cross-env NODE_OPTIONS= PORT=3005 npx nx serve wallet-service",
    "start:all": "concurrently -k -n AUTH,DISPUTE,ESCROW,NOTIFY,WALLET,API \"npm run serve:auth\" \"npm run serve:dispute\" \"npm run serve:escrow\" \"npm run serve:notification\" \"npm run serve:wallet\" \"npm run serve:api\""
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "22.5.3",
    "@nx/eslint-plugin": "22.5.3",
    "@nx/js": "22.5.3",
    "@nx/nest": "^22.5.3",
    "@nx/node": "22.5.3",
    "@nx/web": "22.5.3",
    "@nx/webpack": "22.5.3",
    "@prisma/client": "^7.7.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "20.19.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.18.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.5.1",
    "prettier": "^2.6.2",
    "prisma": "^7.7.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "libs/*"
  ],
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.1.18",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.4.2",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
